        \PYG{p}{],}
        \PYG{n}{tools}\PYG{o}{=}\PYG{p}{[}\PYG{n}{extraction\PYGZus{}tool}\PYG{p}{],}
        \PYG{n}{tool\PYGZus{}choice}\PYG{o}{=}\PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}type\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}function\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}function\PYGZdq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}name\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}extract\PYGZus{}user\PYGZus{}info\PYGZdq{}}\PYG{p}{\PYGZcb{}\PYGZcb{}} \PYG{c+c1}{\PYGZsh{} Buộc mô hình phải dùng công cụ này}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Bước 4: Phân tích kết quả}
    \PYG{n}{tool\PYGZus{}call} \PYG{o}{=} \PYG{n}{response}\PYG{o}{.}\PYG{n}{choices}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{.}\PYG{n}{message}\PYG{o}{.}\PYG{n}{tool\PYGZus{}calls}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}
    \PYG{k}{if} \PYG{n}{tool\PYGZus{}call}\PYG{o}{.}\PYG{n}{function}\PYG{o}{.}\PYG{n}{name} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}extract\PYGZus{}user\PYGZus{}info\PYGZdq{}}\PYG{p}{:}
        \PYG{n}{arguments} \PYG{o}{=} \PYG{n}{json}\PYG{o}{.}\PYG{n}{loads}\PYG{p}{(}\PYG{n}{tool\PYGZus{}call}\PYG{o}{.}\PYG{n}{function}\PYG{o}{.}\PYG{n}{arguments}\PYG{p}{)}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Thông tin đã được trích xuất:\PYGZdq{}}\PYG{p}{)}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{json}\PYG{o}{.}\PYG{n}{dumps}\PYG{p}{(}\PYG{n}{arguments}\PYG{p}{,} \PYG{n}{indent}\PYG{o}{=}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{ensure\PYGZus{}ascii}\PYG{o}{=}\PYG{k+kc}{False}\PYG{p}{))}

