            \PYG{p}{\PYGZcb{}}
        \PYG{p}{\PYGZcb{}}
    \PYG{p}{\PYGZcb{}}

    \PYG{c+c1}{\PYGZsh{} Văn bản đầu vào}
    \PYG{n}{text\PYGZus{}input} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+s2}{    Chào bạn, tôi là Trần Văn An, email của tôi là an.tran@example.com.}
\PYG{l+s+s2}{    Tôi muốn hỏi về tình trạng của đơn hàng \PYGZsh{}A123\PYGZhy{}456. Cảm ơn!}
\PYG{l+s+s2}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{c+c1}{\PYGZsh{} Bước 3: Gọi LLM với công cụ đã định nghĩa}
    \PYG{n}{response} \PYG{o}{=} \PYG{n}{client}\PYG{o}{.}\PYG{n}{chat}\PYG{o}{.}\PYG{n}{completions}\PYG{o}{.}\PYG{n}{create}\PYG{p}{(}
