\begin{MintedVerbatim}[commandchars=\\\{\}]
    \PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{sentence\PYGZus{}transformers}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{SentenceTransformer}
    \PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{chromadb}

    \PYG{c+c1}{\PYGZsh{} Bước 1: Chuẩn bị dữ liệu và tải mô hình}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{SentenceTransformer}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}all\PYGZhy{}MiniLM\PYGZhy{}L6\PYGZhy{}v2\PYGZsq{}}\PYG{p}{)}

    \PYG{n}{documents} \PYG{o}{=} \PYG{p}{[}
        \PYG{l+s+s2}{\PYGZdq{}Trái Đất quay quanh Mặt Trời.\PYGZdq{}}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}Hệ Mặt Trời có tám hành tinh.\PYGZdq{}}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}Mặt Trăng là vệ tinh tự nhiên của Trái Đất.\PYGZdq{}}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}Python là một ngôn ngữ lập trình phổ biến.\PYGZdq{}}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}Học sâu là một nhánh của học máy.\PYGZdq{}}
    \PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} Bước 2: Lập chỉ mục (Embed và Store)}
    \PYG{n}{client} \PYG{o}{=} \PYG{n}{chromadb}\PYG{o}{.}\PYG{n}{Client}\PYG{p}{()}
    \PYG{n}{collection} \PYG{o}{=} \PYG{n}{client}\PYG{o}{.}\PYG{n}{create\PYGZus{}collection}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}semantic\PYGZus{}search\PYGZus{}demo\PYGZdq{}}\PYG{p}{)}

    \PYG{n}{embeddings} \PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{encode}\PYG{p}{(}\PYG{n}{documents}\PYG{p}{)}
    \PYG{n}{collection}\PYG{o}{.}\PYG{n}{add}\PYG{p}{(}
        \PYG{n}{embeddings}\PYG{o}{=}\PYG{n}{embeddings}\PYG{o}{.}\PYG{n}{tolist}\PYG{p}{(),}
        \PYG{n}{documents}\PYG{o}{=}\PYG{n}{documents}\PYG{p}{,}
