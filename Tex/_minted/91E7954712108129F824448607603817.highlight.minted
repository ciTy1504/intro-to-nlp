    \PYG{p}{)}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Đã lập chỉ mục xong!\PYGZdq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Bước 3: Truy vấn}
    \PYG{n}{query} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}Các thiên thể trong vũ trụ\PYGZdq{}}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+se}{\PYGZbs{}n}\PYG{l+s+s2}{Truy vấn: \PYGZsq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{query}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZsq{}\PYGZdq{}}\PYG{p}{)}

    \PYG{n}{query\PYGZus{}embedding} \PYG{o}{=} \PYG{n}{model}\PYG{o}{.}\PYG{n}{encode}\PYG{p}{(}\PYG{n}{query}\PYG{p}{)}\PYG{o}{.}\PYG{n}{tolist}\PYG{p}{()}
    \PYG{n}{results} \PYG{o}{=} \PYG{n}{collection}\PYG{o}{.}\PYG{n}{query}\PYG{p}{(}
        \PYG{n}{query\PYGZus{}embeddings}\PYG{o}{=}\PYG{p}{[}\PYG{n}{query\PYGZus{}embedding}\PYG{p}{],}
        \PYG{n}{n\PYGZus{}results}\PYG{o}{=}\PYG{l+m+mi}{3}
    \PYG{p}{)}

