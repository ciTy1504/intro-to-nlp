    \PYG{k}{for} \PYG{n}{doc} \PYG{o+ow}{in} \PYG{n}{results}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}documents\PYGZsq{}}\PYG{p}{][}\PYG{l+m+mi}{0}\PYG{p}{]:}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}\PYGZhy{} }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{doc}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
