        \PYG{c+c1}{\PYGZsh{} Thực hiện dự đoán}
        \PYG{n}{result} \PYG{o}{=} \PYG{n}{classifier}\PYG{p}{(}\PYG{n}{text\PYGZus{}to\PYGZus{}analyze}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} Trả về kết quả}
        \PYG{k}{return} \PYG{n}{result}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}

