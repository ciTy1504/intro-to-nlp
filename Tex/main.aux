\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Bộ nhớ cho mỗi tham số khi huấn luyện ở độ chính xác hỗn hợp. Phần trọng số BF16, gradient BF16 và bản sao FP32 là cố định (8 byte); phần thay đổi là \emph  {trạng thái bộ tối ưu}. AdamW giữ hai trạng thái FP32 ($m$ và $v$) nên tốn 8 byte, đúng một nửa tổng bộ nhớ. Adam-mini thay $v$ bằng một số cho mỗi khối, còn Muon chỉ giữ momentum; cả hai đưa phần này về 4 byte. Với một mô hình 70B, chênh lệch đó là gần 280 GB. (Muon chỉ áp cho các ma trận ẩn, embedding và lớp ra vẫn dùng AdamW, nên con số thực tế nằm giữa hai mức.)\relax }}{145}{figure.381}\protected@file@percent }
\newlabel{fig:optimizer_memory}{{5.6}{145}{Bộ nhớ cho mỗi tham số khi huấn luyện ở độ chính xác hỗn hợp. Phần trọng số BF16, gradient BF16 và bản sao FP32 là cố định (8 byte); phần thay đổi là \emph {trạng thái bộ tối ưu}. AdamW giữ hai trạng thái FP32 ($m$ và $v$) nên tốn 8 byte, đúng một nửa tổng bộ nhớ. Adam-mini thay $v$ bằng một số cho mỗi khối, còn Muon chỉ giữ momentum; cả hai đưa phần này về 4 byte. Với một mô hình 70B, chênh lệch đó là gần 280 GB. (Muon chỉ áp cho các ma trận ẩn, embedding và lớp ra vẫn dùng AdamW, nên con số thực tế nằm giữa hai mức.)\relax }{figure.381}{}}
