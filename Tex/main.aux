\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Các trường cần có trên span của một lượt gọi mô hình (nhóm trên), một lời gọi công cụ (nhóm giữa) và một bước truy xuất (nhóm dưới), theo quy ước ngữ nghĩa GenAI của OpenTelemetry. Hãy chú ý rằng \emph  {toàn bộ nội dung} -- prompt, câu trả lời, chỉ dẫn hệ thống, tài liệu đã truy xuất, tham số và kết quả của công cụ -- đều ở mức \emph  {Opt-In}, tức là phải bật thì mới được ghi. Đó là một quyết định có chủ ý về kích thước dữ liệu và về quyền riêng tư, bàn ở mục~\ref  {ssec:trace_sampling_privacy}.\relax }}{418}{table.caption.1223}\protected@file@percent }
\newlabel{tab:llm_trace_fields}{{3.1}{418}{Các trường cần có trên span của một lượt gọi mô hình (nhóm trên), một lời gọi công cụ (nhóm giữa) và một bước truy xuất (nhóm dưới), theo quy ước ngữ nghĩa GenAI của OpenTelemetry. Hãy chú ý rằng \emph {toàn bộ nội dung} -- prompt, câu trả lời, chỉ dẫn hệ thống, tài liệu đã truy xuất, tham số và kết quả của công cụ -- đều ở mức \emph {Opt-In}, tức là phải bật thì mới được ghi. Đó là một quyết định có chủ ý về kích thước dữ liệu và về quyền riêng tư, bàn ở mục~\ref {ssec:trace_sampling_privacy}.\relax }{table.caption.1223}{}}
