\@writefile{toc}{\contentsline {paragraph}{Transformer gần như bắt buộc dùng Adam.}{141}{figure.359}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.2}Adam: Tốc độ học thích nghi cho từng tham số}{141}{subsection.360}\protected@file@percent }
\newlabel{ssec:adam}{{5.3.2}{141}{Adam: Tốc độ học thích nghi cho từng tham số}{subsection.360}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Hai chi tiết nhỏ làm nên Adam. \textbf  {Trái:} Với gradient hằng $g = 1$ và $\beta _1 = 0.9$, trung bình trượt $m_t$ xuất phát từ $0$ nên những bước đầu bị kéo thấp hơn giá trị thật rất nhiều (ở bước 1 chỉ bằng $0.1$); phép chia cho $1 - \beta _1^t$ đưa ước lượng về đúng $1$ ngay từ bước đầu tiên. \textbf  {Phải:} Độ lớn bước cập nhật theo độ lớn gradient. SGD tỷ lệ thuận với $|g|$, còn Adam bão hòa ở trần $\eta $: chỉ khi $|g|$ rơi xuống cỡ $\epsilon $ thì bước mới nhỏ lại. Đây chính là tính chất “đi theo dấu” khiến Adam bền vững trước chênh lệch thang đo giữa các khối tham số.\relax }}{141}{figure.363}\protected@file@percent }
\newlabel{fig:adam_bias_step}{{5.4}{141}{Hai chi tiết nhỏ làm nên Adam. \textbf {Trái:} Với gradient hằng $g = 1$ và $\beta _1 = 0.9$, trung bình trượt $m_t$ xuất phát từ $0$ nên những bước đầu bị kéo thấp hơn giá trị thật rất nhiều (ở bước 1 chỉ bằng $0.1$); phép chia cho $1 - \beta _1^t$ đưa ước lượng về đúng $1$ ngay từ bước đầu tiên. \textbf {Phải:} Độ lớn bước cập nhật theo độ lớn gradient. SGD tỷ lệ thuận với $|g|$, còn Adam bão hòa ở trần $\eta $: chỉ khi $|g|$ rơi xuống cỡ $\epsilon $ thì bước mới nhỏ lại. Đây chính là tính chất “đi theo dấu” khiến Adam bền vững trước chênh lệch thang đo giữa các khối tham số.\relax }{figure.363}{}}
