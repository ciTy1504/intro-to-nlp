\newlabel{ssec:sgd_to_adam}{{5.3.1}{140}{Từ SGD đến Adam: vai trò của hai moment}{subsection.358}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Tác dụng của momentum và tốc độ học thích nghi. Hàm mục tiêu là một dạng toàn phương có số điều kiện 150, tức một thung lũng rất hẹp. Cả ba cùng xuất phát từ một điểm, cùng chạy 40 bước, mỗi bộ tối ưu dùng learning rate lớn nhất mà nó còn ổn định. SGD buộc phải chọn bước thật nhỏ để không bùng nổ theo hướng dốc, nên nó dao động qua lại và sau 40 bước vẫn còn cách xa cực tiểu; momentum cộng dồn các bước nhất quán dọc thung lũng; Adam chuẩn hóa theo từng tọa độ nên đi những bước gần bằng nhau ở cả hai hướng. Lưu ý đây chỉ là minh họa hai chiều: trên Transformer, khoảng cách thật giữa SGD và Adam lớn hơn nhiều, vì chênh lệch thang đo trải trên hàng tỷ tham số chứ không phải hai.\relax }}{140}{figure.359}\protected@file@percent }
\newlabel{fig:optimizer_trajectories}{{5.3}{140}{Tác dụng của momentum và tốc độ học thích nghi. Hàm mục tiêu là một dạng toàn phương có số điều kiện 150, tức một thung lũng rất hẹp. Cả ba cùng xuất phát từ một điểm, cùng chạy 40 bước, mỗi bộ tối ưu dùng learning rate lớn nhất mà nó còn ổn định. SGD buộc phải chọn bước thật nhỏ để không bùng nổ theo hướng dốc, nên nó dao động qua lại và sau 40 bước vẫn còn cách xa cực tiểu; momentum cộng dồn các bước nhất quán dọc thung lũng; Adam chuẩn hóa theo từng tọa độ nên đi những bước gần bằng nhau ở cả hai hướng. Lưu ý đây chỉ là minh họa hai chiều: trên Transformer, khoảng cách thật giữa SGD và Adam lớn hơn nhiều, vì chênh lệch thang đo trải trên hàng tỷ tham số chứ không phải hai.\relax }{figure.359}{}}
\@writefile{toc}{\contentsline {paragraph}{Một cách nhìn khác: Adam gần với “đi theo dấu của gradient”.}{140}{figure.359}\protected@file@percent }
