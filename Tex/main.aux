\newlabel{eq:minhash_scurve}{{1.1}{361}{Hiểu cái núm của MinHash}{equation.1058}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Cùng gọi là “khử trùng lặp mờ”, nhưng cấu hình quyết định hành vi. Tại đúng ngưỡng 0{,}75 mà FineWeb nhắm tới, cấu hình của họ ($b=14$, $r=8$) bắt được \textbf  {77\%} số cặp, trong khi cấu hình mặc định của NeMo Curator ($b=20$, $r=13$) chỉ bắt \textbf  {38\%} -- chặt hơn hẳn. Còn một cấu hình lỏng như $b=32$, $r=4$ sẽ gắn cờ \textbf  {87\%} số cặp chỉ giống nhau một nửa, tức là xóa sạch những tài liệu khác nhau thật sự. Đây là lý do không thể chép cấu hình MinHash từ dự án này sang dự án khác mà không tính lại.\relax }}{361}{figure.1059}\protected@file@percent }
\newlabel{fig:minhash_s_curve}{{1.4}{361}{Cùng gọi là “khử trùng lặp mờ”, nhưng cấu hình quyết định hành vi. Tại đúng ngưỡng 0{,}75 mà FineWeb nhắm tới, cấu hình của họ ($b=14$, $r=8$) bắt được \textbf {77\%} số cặp, trong khi cấu hình mặc định của NeMo Curator ($b=20$, $r=13$) chỉ bắt \textbf {38\%} -- chặt hơn hẳn. Còn một cấu hình lỏng như $b=32$, $r=4$ sẽ gắn cờ \textbf {87\%} số cặp chỉ giống nhau một nửa, tức là xóa sạch những tài liệu khác nhau thật sự. Đây là lý do không thể chép cấu hình MinHash từ dự án này sang dự án khác mà không tính lại.\relax }{figure.1059}{}}
